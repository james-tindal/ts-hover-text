{
  "name": "ts-hover-text",
  "version": "1.0.0",
  "description": "Get TypeScript hover text (QuickInfo) for test assertions.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "vitest run --bail 1",
    "test:watch": "vitest"
  },
  "keywords": [
    "typescript",
    "hover",
    "quickinfo",
    "testing",
    "types",
    "intellisense"
  ],
  "author": "James Tindal",
  "license": "🤷‍♂️",
  "peerDependencies": {
    "typescript": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@types/node": "^25.2.0",
    "package-directory": "^8.2.0"
  }
}
